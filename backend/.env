# ========================================================
# NITK AutoTTGen SMTP Configuration
# Set your email credentials below so the system directly
# sends live verification emails with the subject:
# "NITK AutoTTGen Verification Code: <OTP>"
# ========================================================

# For Gmail:
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an App Password for 'AutoTTGen'
# 4. Fill in your Gmail address and the 16-character app password below

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply-autottgen@nitk.edu.in
